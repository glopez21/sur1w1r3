# Sur1W1r3 — ThreatPulse sensor configuration
#
# Copy to /etc/suricata-shipper.env, chmod 0600, and fill in the secrets.
# Every value can also be supplied via the environment or systemd drop-in.
#
# The "label" in each *INGEST_KEYS value on the ThreatPulse side must match the
# --source here so records are attributable to a specific host.

# --- Identity ----------------------------------------------------------------
# Must match the label configured in ThreatPulse's NETWORK_MONITOR_INGEST_KEYS.
EVE_SHIPPER_SOURCE=akamai-web-01

# --- ThreatPulse endpoints ---------------------------------------------------
# Path /api/network/... is nginx's reverse proxy to network-monitor:8010.
EVE_SHIPPER_FLOW_URL=https://threatpulse.example.com/api/network/api/v1/traffic/ingest/batch
# Path /api/siem/... is Traefik's route to siem-app.
EVE_SHIPPER_ALERT_URL=https://threatpulse.example.com/api/siem/api/v1/webhooks

# --- Credentials -------------------------------------------------------------
# Generate with: openssl rand -base64 32
EVE_SHIPPER_FLOW_API_KEY=
# Either an siem-app API key or the shared WEBHOOK_SECRET for HMAC signing.
EVE_SHIPPER_ALERT_WEBHOOK_SECRET=

# --- Collection --------------------------------------------------------------
EVE_SHIPPER_EVE_PATH=/var/log/suricata/eve.json
EVE_SHIPPER_STATE_PATH=/var/lib/suricata-shipper/state.json
# Leave empty to auto-detect egress addresses. The onboard script instead
# discovers addresses on the selected/default route interface.
EVE_SHIPPER_LOCAL_ADDRESSES=[]
EVE_SHIPPER_AUTO_DETECT_ADDRESSES=true

# --- Tuning ------------------------------------------------------------------
EVE_SHIPPER_INTERVAL=10
EVE_SHIPPER_FLOW_BATCH_SIZE=250
EVE_SHIPPER_ALERT_BATCH_SIZE=100
# Must stay at or below network-monitor's MAX_FLOWS_PER_REQUEST (default 500).
EVE_SHIPPER_TLS_VERIFY=true
EVE_SHIPPER_LOG_LEVEL=INFO
